    "validation = {\n",
    "    \"manual_silhouette\": float(manual_metrics[\"Silhouette\"]),\n",
    "    \"manual_inertia\": float(manual_model.inertia_),\n",
    "    \"manual_inertia_monotonic\": manual_monotonic,\n",
    "    \"sklearn_silhouette\": float(sklearn_metrics[\"Silhouette\"]),\n",
    "    \"sklearn_ari\": float(sklearn_metrics[\"ARI\"]),\n",
    "    \"wine_silhouette\": float(wine_metrics[\"Silhouette\"]),\n",
    "    \"wine_davies_bouldin\": float(wine_metrics[\"Davies-Bouldin\"]),\n",
    "    \"wine_ari\": float(wine_metrics[\"ARI\"]),\n",
    "    \"image_count\": 10,\n",
    "}\n",
    "assert validation[\"manual_inertia_monotonic\"]\n",
    "assert validation[\"manual_silhouette\"] >= 0.50\n",
    "assert validation[\"sklearn_silhouette\"] >= 0.50\n",
    "assert validation[\"sklearn_ari\"] >= 0.80\n",
    "assert validation[\"wine_silhouette\"] > 0.20\n",
    "\n",
    "validation_rows = [\n",
    "    [\"Scratch inertia monotonic\", validation[\"manual_inertia_monotonic\"], \"Pass\"],\n",
    "    [\"Scratch silhouette\", f'{validation[\"manual_silhouette\"]:.3f}', \"Pass\"],\n",
    "    [\"sklearn silhouette\", f'{validation[\"sklearn_silhouette\"]:.3f}', \"Pass\"],\n",
    "    [\"sklearn ARI\", f'{validation[\"sklearn_ari\"]:.3f}', \"Pass\"],\n",
    "    [\"Wine silhouette\", f'{validation[\"wine_silhouette\"]:.3f}', \"Pass\"],\n",
    "    [\"Figures produced\", validation[\"image_count\"], \"Pass\"],\n",
    "]\n",
    "display_result_table(\n",
    "    \"Notebook 验证汇总（Notebook validation summary）\",\n",
    "    [\"Check\", \"Observed\", \"Status\"],\n",
    "    validation_rows,\n",
    "    hidden_comment=\"VALIDATION \" + json.dumps(validation, ensure_ascii=False),\n",
    ")"
