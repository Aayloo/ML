    "def lloyd_trace(X, initial_centers, steps=10):\n",
    "    centers = initial_centers.copy()\n",
    "    center_history, inertia_history = [centers.copy()], []\n",
    "    for _ in range(steps):\n",
    "        squared = ((X[:, None] - centers[None]) ** 2).sum(axis=2)\n",
    "        labels = squared.argmin(axis=1)\n",
    "        inertia_history.append(float(squared[np.arange(len(X)), labels].sum()))\n",
    "        updated = np.vstack([X[labels == k].mean(axis=0) for k in range(len(centers))])\n",
    "        center_history.append(updated.copy())\n",
    "        if np.allclose(updated, centers):\n",
    "            break\n",
    "        centers = updated\n",
    "    return labels, np.asarray(center_history), inertia_history\n",
    "\n",
    "\n",
    "trace_X, _ = make_blobs(n_samples=240, centers=3, cluster_std=0.75, random_state=8)\n",
    "trace_labels, center_trace, inertia_trace = lloyd_trace(trace_X, trace_X[[3, 80, 180]])\n",
    "fig, axes = plt.subplots(1, 2, figsize=(10.5, 4.1))\n",
    "axes[0].scatter(*trace_X.T, c=trace_labels, cmap=\"viridis\", s=22)\n",
    "for k, color in enumerate(PALETTE[:3]):\n",
    "    axes[0].plot(center_trace[:, k, 0], center_trace[:, k, 1], \"o-\", color=color)\n",
    "axes[0].set(title=\"Centroid Paths\", xlabel=\"Feature 1\", ylabel=\"Feature 2\")\n",
    "axes[1].plot(range(1, len(inertia_trace) + 1), inertia_trace, \"o-\", color=BLUE)\n",
    "axes[1].set(title=\"Inertia by Iteration\", xlabel=\"Iteration\", ylabel=\"Inertia\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
