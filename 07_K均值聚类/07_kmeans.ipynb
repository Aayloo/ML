    "k_records = []\n",
    "fitted_by_k = {}\n",
    "for candidate_k in range(2, 9):\n",
    "    candidate_model = KMeans(\n",
    "        n_clusters=candidate_k,\n",
    "        init=\"k-means++\",\n",
    "        n_init=10,\n",
    "        random_state=RANDOM_STATE,\n",
    "    ).fit(scaled_X)\n",
    "    fitted_by_k[candidate_k] = candidate_model\n",
    "    k_records.append({\n",
    "        \"K\": candidate_k,\n",
    "        \"Inertia\": candidate_model.inertia_,\n",
    "        \"Silhouette\": silhouette_score(scaled_X, candidate_model.labels_),\n",
    "    })\n",
    "k_selection = pd.DataFrame(k_records)\n",
    "best_k = int(k_selection.loc[k_selection[\"Silhouette\"].idxmax(), \"K\"])\n",
    "k_selection.round(3)"
   ]
