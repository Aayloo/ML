    "def display_result_table(title, headers, rows, hidden_comment=\"\"):\n",
    "    header_html = \"\".join(\n",
    "        f'<th style=\"padding:8px 12px;text-align:left;background:#eef3ff\">{item}</th>'\n",
    "        for item in headers\n",
    "    )\n",
    "    row_html = \"\".join(\n",
    "        \"<tr>\" + \"\".join(\n",
    "            f'<td style=\"padding:7px 12px;border-top:1px solid #dde3ee\">{value}</td>'\n",
    "            for value in row\n",
    "        ) + \"</tr>\"\n",
    "        for row in rows\n",
    "    )\n",
    "    comment_html = f\"<!-- {hidden_comment} -->\" if hidden_comment else \"\"\n",
    "    display(HTML(\n",
    "        f'<div style=\"max-width:880px\"><h4>{title}</h4>'\n",
    "        f'<table style=\"border-collapse:collapse;width:100%;font-size:14px\">'\n",
    "        f'<thead><tr>{header_html}</tr></thead><tbody>{row_html}</tbody></table>'\n",
    "        f'{comment_html}</div>'\n",
    "    ))\n",
    "\n",
    "\n",
    "def evaluate_clustering(X, labels, inertia, reference_labels=None):\n",
    "    result = {\n",
    "        \"Inertia\": float(inertia),\n",
    "        \"Silhouette\": float(silhouette_score(X, labels)),\n",
    "        \"Davies-Bouldin\": float(davies_bouldin_score(X, labels)),\n",
    "        \"Calinski-Harabasz\": float(calinski_harabasz_score(X, labels)),\n",
    "    }\n",
    "    if reference_labels is not None:\n",
    "        result[\"ARI\"] = float(adjusted_rand_score(reference_labels, labels))\n",
    "        result[\"NMI\"] = float(normalized_mutual_info_score(reference_labels, labels))\n",
    "    return result"
   ]
