   "source": [
    "### 2.4 模型实现：`KMeansScratch`\n",
    "\n",
    "手写版本使用 k-means++ 思想初始化，并保存质心轨迹与每轮 inertia，便于观察优化过程。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "7e1aa46b",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-04T08:02:08.300899Z",
     "iopub.status.busy": "2026-08-04T08:02:08.300576Z",
     "iopub.status.idle": "2026-08-04T08:02:08.312729Z",
     "shell.execute_reply": "2026-08-04T08:02:08.311437Z"
    }
   },
   "outputs": [],
   "source": [
    "class KMeansScratch:\n",
    "    def __init__(self, n_clusters=3, max_iter=100, tol=1e-4, random_state=42):\n",
    "        self.n_clusters = int(n_clusters)\n",
    "        self.max_iter = int(max_iter)\n",
    "        self.tol = float(tol)\n",
    "        self.random_state = random_state\n",
    "\n",
    "    def _squared_distances(self, X, centers):\n",
    "        return ((X[:, None, :] - centers[None, :, :]) ** 2).sum(axis=2)\n",
    "\n",
    "    def _initialize_centroids(self, X):\n",
    "        rng = np.random.default_rng(self.random_state)\n",
    "        centers = [X[rng.integers(len(X))]]\n",
    "        while len(centers) < self.n_clusters:\n",
    "            squared = self._squared_distances(X, np.asarray(centers))\n",
    "            closest = squared.min(axis=1)\n",
    "            probabilities = closest / closest.sum()\n",
    "            centers.append(X[rng.choice(len(X), p=probabilities)])\n",
    "        return np.asarray(centers, dtype=float)\n",
    "\n",
    "    def fit(self, X):\n",
    "        X = np.asarray(X, dtype=float)\n",
    "        centers = self._initialize_centroids(X)\n",
    "        self.centroid_history_ = [centers.copy()]\n",
    "        self.inertia_history_ = []\n",
    "        for _ in range(self.max_iter):\n",
    "            squared = self._squared_distances(X, centers)\n",
    "            labels = squared.argmin(axis=1)\n",
    "            self.inertia_history_.append(\n",
    "                float(squared[np.arange(len(X)), labels].sum())\n",
    "            )\n",
    "            nearest = squared[np.arange(len(X)), labels]\n",
    "            updated = []\n",
    "            for cluster in range(self.n_clusters):\n",
    "                members = X[labels == cluster]\n",
    "                updated.append(members.mean(axis=0) if len(members) else X[nearest.argmax()])\n",
    "            updated = np.asarray(updated)\n",
    "            self.centroid_history_.append(updated.copy())\n",
    "            movement = np.linalg.norm(updated - centers, axis=1).max()\n",
    "            centers = updated\n",
    "            if movement <= self.tol:\n",
    "                break\n",
    "        self.cluster_centers_ = centers\n",
    "        final_squared = self._squared_distances(X, centers)\n",
    "        self.labels_ = final_squared.argmin(axis=1)\n",
    "        self.inertia_ = float(final_squared[np.arange(len(X)), self.labels_].sum())\n",
    "        if self.inertia_ < self.inertia_history_[-1] - 1e-12:\n",
    "            self.inertia_history_.append(self.inertia_)\n",
    "        self.n_iter_ = len(self.inertia_history_)\n",
    "        return self\n",
    "\n",
    "    def predict(self, X):\n",
    "        X = np.asarray(X, dtype=float)\n",
    "        return self._squared_distances(X, self.cluster_centers_).argmin(axis=1)\n",
    "\n",
    "    def fit_predict(self, X):\n",
    "        return self.fit(X).labels_"
   ]
