   "source": "bill = credit[\"BILL_AMT1\"]\npay = credit[\"PAY_AMT1\"]\n\ndef count_outliers(series):\n    q1, q3 = series.quantile(0.25), series.quantile(0.75)\n    iqr = q3 - q1\n    mask = (series < q1 - 1.5 * iqr) | (series > q3 + 1.5 * iqr)\n    return mask.sum(), mask.mean()\n\nbill_outliers, bill_ratio = count_outliers(bill)\npay_outliers, pay_ratio = count_outliers(pay)\nprint(\n    f\"BILL_AMT1 按 IQR 规则的异常值: {bill_outliers} ({bill_ratio:.1%})\"\n)\nprint(\n    f\"PAY_AMT1 按 IQR 规则的异常值: {pay_outliers} ({pay_ratio:.1%})\"\n)\n\nfig, axes = plt.subplots(1, 2, figsize=(10.5, 3.8))\naxes[0].boxplot(bill, tick_labels=[\"BILL_AMT1\"])\naxes[0].set(title=\"Bill Amount (NT$): Boxplot\", ylabel=\"Value\")\naxes[1].boxplot(pay, tick_labels=[\"PAY_AMT1\"])\naxes[1].set(title=\"Payment Amount (NT$): Boxplot\", ylabel=\"Value\")\nfor ax in axes:\n    ax.grid(axis=\"y\", alpha=0.2)\nfig.tight_layout()\nplt.show()"
  },
