     "iopub.status.idle": "2026-08-07T09:14:37.550766Z"
    }
   },
   "outputs": [
    {
     "output_type": "stream",
     "name": "stdout",
     "text": "原始两列:\n[[2. 3.]\n [4. 5.]]\n二次多项式展开（含交叉项 x1*x2）:\n[[ 2.  3.  4.  6.  9.]\n [ 4.  5. 16. 20. 25.]]\n特征名: ['x1' 'x2' 'x1^2' 'x1 x2' 'x2^2']\n"
    }
   ],
   "source": "from sklearn.preprocessing import PolynomialFeatures\n\nsample_X = np.array([\n    [2.0, 3.0],\n    [4.0, 5.0],\n])\npoly = PolynomialFeatures(degree=2, include_bias=False)\nsample_poly = poly.fit_transform(sample_X)\n\nprint(\"原始两列:\")\nprint(sample_X)\nprint(\"二次多项式展开（含交叉项 x1*x2）:\")\nprint(sample_poly)\nprint(\"特征名:\", poly.get_feature_names_out([\"x1\", \"x2\"]))"
  },
