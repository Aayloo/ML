   "source": "from sklearn.datasets import load_breast_cancer\nfrom sklearn.ensemble import RandomForestClassifier\nfrom sklearn.feature_selection import RFE\nfrom sklearn.linear_model import LogisticRegression\n\n# 嵌入法：随机森林特征重要性（信用卡）\nrf_for_importance = RandomForestClassifier(\n    n_estimators=100,\n    random_state=42,\n)\nrf_for_importance.fit(\n    X_credit_engineered,\n    y_credit_all,\n)\nimportance = rf_for_importance.feature_importances_\nimportance_order = np.argsort(importance)[::-1][:12]\n\nfig, ax = plt.subplots(figsize=(8.0, 4.6))\nax.barh(\n    [\n        str(X_credit_engineered.columns[i])\n        for i in importance_order\n    ][::-1],\n    importance[importance_order][::-1],\n    color=\"#4C78A8\",\n)\nax.set(\n    xlabel=\"Feature importance\",\n    title=\"Embedded: Random Forest Feature Importance\",\n)\nax.grid(axis=\"x\", alpha=0.2)\nplt.show()\n\n# 包裹法：RFE（乳腺癌，速度快）\ncancer = load_breast_cancer()\nrfe = RFE(\n    LogisticRegression(max_iter=2000),\n    n_features_to_select=10,\n)\nrfe.fit(cancer.data, cancer.target)\nselected_features = [\n    cancer.feature_names[i]\n    for i in range(len(cancer.data[0]))\n    if rfe.support_[i]\n]\nprint(\"RFE 从 30 个特征中选出的 10 个:\")\nprint(selected_features)"
  },
