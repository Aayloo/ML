     "text": "数值列数: 25\n类别列数: 3\n示例：预处理前 5 列 → ['LIMIT_BAL', 'AGE', 'PAY_0', 'PAY_2', 'PAY_3', 'SEX', 'EDUCATION', 'MARRIAGE']\n"
    }
   ],
   "source": "from sklearn.compose import ColumnTransformer\nfrom sklearn.impute import SimpleImputer\nfrom sklearn.pipeline import Pipeline\nfrom sklearn.preprocessing import (\n    OneHotEncoder,\n    StandardScaler,\n)\n\ncategorical_columns = [\"SEX\", \"EDUCATION\", \"MARRIAGE\"]\nnumeric_columns = [\n    column\n    for column in X_credit_engineered.columns\n    if column not in categorical_columns\n]\n\npreprocessor = ColumnTransformer([\n    (\n        \"numeric\",\n        Pipeline([\n            (\"imputer\", SimpleImputer(strategy=\"median\")),\n            (\"scaler\", StandardScaler()),\n        ]),\n        numeric_columns,\n    ),\n    (\n        \"categorical\",\n        OneHotEncoder(handle_unknown=\"ignore\"),\n        categorical_columns,\n    ),\n])\n\nprint(\"数值列数:\", len(numeric_columns))\nprint(\"类别列数:\", len(categorical_columns))\nprint(\n    \"示例：预处理前 5 列 →\",\n    numeric_columns[:5] + categorical_columns,\n)"
  },
