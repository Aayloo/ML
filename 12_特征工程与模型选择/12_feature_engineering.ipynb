   "source": "param_grid = {\n    \"classifier__C\": [0.01, 0.1, 1, 10],\n    \"classifier__class_weight\": [None, \"balanced\"],\n}\n\ngrid_search = GridSearchCV(\n    engineered_pipeline,\n    param_grid,\n    cv=5,\n    scoring=\"roc_auc\",\n)\ngrid_search.fit(credit_X_train, credit_y_train)\n\nprint(\"最优参数:\", grid_search.best_params_)\nprint(\"最优 CV ROC-AUC:\", round(grid_search.best_score_, 4),\n      \"（工程基线:\", round(engineered_cv_mean, 4), \"）\")\n\ngrid_results = pd.DataFrame(grid_search.cv_results_)\nheatmap_data = grid_results.pivot(\n    index=\"param_classifier__class_weight\",\n    columns=\"param_classifier__C\",\n    values=\"mean_test_score\",\n)\nheatmap_data = heatmap_data[\n    sorted(heatmap_data.columns)\n]\n\nfig, ax = plt.subplots(figsize=(6.8, 3.2))\nimage = ax.imshow(\n    heatmap_data.values,\n    cmap=\"viridis\",\n    vmin=heatmap_data.values.min(),\n    vmax=heatmap_data.values.max(),\n)\nax.set_xticks(range(len(heatmap_data.columns)))\nax.set_xticklabels(heatmap_data.columns)\nax.set_yticks(range(len(heatmap_data.index)))\nax.set_yticklabels(heatmap_data.index)\nfor row in range(heatmap_data.shape[0]):\n    for col in range(heatmap_data.shape[1]):\n        ax.text(\n            col,\n            row,\n            f\"{heatmap_data.values[row, col]:.4f}\",\n            ha=\"center\",\n            va=\"center\",\n            color=\"white\",\n            fontsize=9,\n        )\nax.set(\n    xlabel=\"C\",\n    ylabel=\"class_weight\",\n    title=\"GridSearchCV: Mean Test ROC-AUC\",\n)\nfig.colorbar(image, ax=ax)\nplt.show()"
  },
