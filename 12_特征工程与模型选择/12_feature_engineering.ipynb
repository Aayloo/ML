   "source": "engineered_pipeline = Pipeline([\n    (\"preprocessor\", preprocessor),\n    (\n        \"classifier\",\n        LogisticRegression(\n            solver=\"liblinear\",\n            max_iter=2000,\n            random_state=42,\n        ),\n    ),\n])\n\nengineered_scores = cross_val_score(\n    engineered_pipeline,\n    credit_X_train,\n    credit_y_train,\n    cv=5,\n    scoring=\"roc_auc\",\n)\nengineered_cv_mean = engineered_scores.mean()\nprint(\"工程版 5 折 ROC-AUC:\", np.round(\n    engineered_scores, 4\n))\nprint(\"工程版平均 ROC-AUC:\", round(engineered_cv_mean, 4))\n\nfig, ax = plt.subplots(figsize=(6.5, 4.0))\nax.bar(\n    [\"Baseline (no engineering)\", \"Feature-engineered\"],\n    [baseline_cv_mean, engineered_cv_mean],\n    color=[\"#888888\", \"#4C78A8\"],\n)\nax.set(\n    ylabel=\"Mean CV ROC-AUC\",\n    title=\"Feature Engineering Improves the Pipeline\",\n    ylim=(0.5, 0.9),\n)\nax.grid(axis=\"y\", alpha=0.2)\nplt.show()"
