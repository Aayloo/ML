   "source": "from sklearn.feature_selection import mutual_info_classif\n\ntarget_corr = X_credit_engineered.corrwith(\n    pd.Series(y_credit_all)\n).abs().sort_values(ascending=False)\nprint(\"与目标 |相关系数| 前 10 的特征:\")\nprint(target_corr.head(10).round(4))\n\nmutual_info = mutual_info_classif(\n    X_credit_engineered,\n    y_credit_all,\n    random_state=42,\n)\nmutual_rank = np.argsort(mutual_info)[::-1]\nprint()\nprint(\"互信息排名前 10 的特征:\")\nfor rank in mutual_rank[:10]:\n    print(\n        f\"  {X_credit_engineered.columns[rank]}: \"\n        f\"{mutual_info[rank]:.4f}\"\n    )\n\ntop_names = target_corr.head(12).index\nfig, axes = plt.subplots(1, 2, figsize=(12.5, 4.2))\naxes[0].barh(\n    [str(name) for name in top_names][::-1],\n    target_corr.head(12).values[::-1],\n    color=\"#4C78A8\",\n)\naxes[0].set(\n    title=\"Filter: |Correlation with Target|\",\n    xlabel=\"|corr|\",\n)\naxes[1].barh(\n    [str(X_credit_engineered.columns[i]) for i in mutual_rank[:12]][::-1],\n    mutual_info[mutual_rank[:12]][::-1],\n    color=\"#E45756\",\n)\naxes[1].set(\n    title=\"Filter: Mutual Information\",\n    xlabel=\"MI\",\n)\nfor ax in axes:\n    ax.grid(axis=\"x\", alpha=0.2)\nfig.tight_layout()\nplt.show()"
  },
