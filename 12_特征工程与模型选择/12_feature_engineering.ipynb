   "source": "# 流程总览图\nimport numpy as np\nimport matplotlib.pyplot as plt\n\nstages = [\n    \"1 Clean\",\n    \"2 Transform\",\n    \"3 Encode\",\n    \"4 Generate\",\n    \"5 Select\",\n    \"6 Validate\",\n]\nfig, ax = plt.subplots(figsize=(12.0, 2.4))\nbox_width, box_height, gap = 1.75, 0.9, 0.35\nfor index, stage in enumerate(stages):\n    x = index * (box_width + gap)\n    color = \"#4C78A8\" if index < 5 else \"#E45756\"\n    ax.add_patch(\n        plt.Rectangle(\n            (x, 0),\n            box_width,\n            box_height,\n            facecolor=color,\n            edgecolor=\"white\",\n            linewidth=0,\n        )\n    )\n    ax.text(\n        x + box_width / 2,\n        box_height / 2,\n        stage,\n        ha=\"center\",\n        va=\"center\",\n        color=\"white\",\n        fontsize=12,\n        fontweight=\"bold\",\n    )\n    if index < len(stages) - 1:\n        ax.annotate(\n            \"\",\n            xy=(\n                x + box_width + gap - 0.05,\n                box_height / 2,\n            ),\n            xytext=(\n                x + box_width + 0.05,\n                box_height / 2,\n            ),\n            arrowprops={\n                \"arrowstyle\": \"-|>\",\n                \"color\": \"#333333\",\n                \"lw\": 1.6,\n            },\n        )\nax.set_xlim(\n    -0.2,\n    len(stages) * (box_width + gap) - gap + 0.2,\n)\nax.set_ylim(-0.2, box_height + 0.2)\nax.axis(\"off\")\nax.set_title(\n    \"Feature Engineering Pipeline: From Raw Data to Usable Features\"\n)\nplt.show()"
  },
