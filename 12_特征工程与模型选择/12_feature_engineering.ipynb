   "source": "from sklearn.preprocessing import (\n    OneHotEncoder,\n    OrdinalEncoder,\n)\n\nsample_df = pd.DataFrame({\n    \"age\": [25, 31, 45, 28, 52],\n    \"city\": [\"北京\", \"上海\", \"北京\", \"广州\", \"上海\"],\n    \"education\": [\"本科\", \"硕士\", \"博士\", \"本科\", \"硕士\"],\n})\n\nordinal_encoder = OrdinalEncoder(\n    categories=[[\"本科\", \"硕士\", \"博士\"]]\n)\neducation_codes = ordinal_encoder.fit_transform(\n    sample_df[[\"education\"]]\n)\ncity_encoder = OneHotEncoder(sparse_output=False)\ncity_onehot = city_encoder.fit_transform(\n    sample_df[[\"city\"]]\n)\n\nprint(\"序数编码结果:\", education_codes.ravel())\nprint(\"独热编码类别:\", city_encoder.categories_[0])\nprint(\"独热编码矩阵:\")\nprint(city_onehot)\n\nfig, ax = plt.subplots(figsize=(6.5, 3.4))\nimage = ax.imshow(city_onehot, cmap=\"Blues\")\nax.set_yticks(range(len(sample_df)))\nax.set_yticklabels(sample_df[\"city\"].values)\nax.set_xticks(range(3))\nax.set_xticklabels(city_encoder.categories_[0])\nax.set_title(\"One-Hot Encoding of City\")\nfor row in range(city_onehot.shape[0]):\n    for col in range(city_onehot.shape[1]):\n        ax.text(\n            col,\n            row,\n            str(int(city_onehot[row, col])),\n            ha=\"center\",\n            va=\"center\",\n        )\nfig.colorbar(image, ax=ax)\nplt.show()"
