   "source": "from sklearn.preprocessing import (\n    MinMaxScaler,\n    RobustScaler,\n    StandardScaler,\n)\n\ndemo_columns = [\"LIMIT_BAL\", \"AGE\", \"BILL_AMT1\"]\nX_demo = credit[demo_columns].values\n\nscalers = {\n    \"Original\": None,\n    \"StandardScaler\": StandardScaler(),\n    \"MinMaxScaler\": MinMaxScaler(),\n    \"RobustScaler\": RobustScaler(),\n}\ntransformed = {\n    name: (\n        X_demo\n        if scaler is None\n        else scaler.fit_transform(X_demo)\n    )\n    for name, scaler in scalers.items()\n}\n\nprint(\"StandardScaler 后各列均值:\", np.round(\n    transformed[\"StandardScaler\"].mean(axis=0), 4\n))\nprint(\"StandardScaler 后各列标准差:\", np.round(\n    transformed[\"StandardScaler\"].std(axis=0), 4\n))\nprint(\"MinMaxScaler 后范围:\", np.round(\n    transformed[\"MinMaxScaler\"].min(axis=0), 3),\n    \"→\",\n    np.round(transformed[\"MinMaxScaler\"].max(axis=0), 3),\n)\n\nfig, axes = plt.subplots(1, 4, figsize=(14.0, 3.8))\nfor ax, (name, X) in zip(axes, transformed.items()):\n    ax.boxplot(\n        [X[:, 0], X[:, 1], X[:, 2]],\n        tick_labels=[\"LIMIT_BAL\", \"AGE\", \"BILL_AMT1\"],\n    )\n    ax.set(title=name)\n    ax.grid(axis=\"y\", alpha=0.2)\nfig.tight_layout()\nplt.show()"
  },
