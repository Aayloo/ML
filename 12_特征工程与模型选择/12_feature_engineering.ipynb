   "source": "import json\n\nall_values = [\n    naive_corr,\n    oof_corr,\n    leaky_scores.mean(),\n    correct_scores.mean(),\n    baseline_cv_mean,\n    engineered_cv_mean,\n    grid_search.best_score_,\n    *credit_test_metrics.values(),\n]\nassert np.all(np.isfinite(all_values))\nassert naive_corr > oof_corr\nassert leaky_scores.mean() > correct_scores.mean()\nassert engineered_cv_mean > baseline_cv_mean\nassert grid_search.best_score_ >= engineered_cv_mean\nassert credit_test_metrics[\"ROC-AUC\"] > 0.72\n\nvalidation = {\n    \"naive_target_corr\": float(naive_corr),\n    \"oof_target_corr\": float(oof_corr),\n    \"leaky_cv_auc\": float(leaky_scores.mean()),\n    \"correct_cv_auc\": float(correct_scores.mean()),\n    \"baseline_cv_auc\": float(baseline_cv_mean),\n    \"engineered_cv_auc\": float(engineered_cv_mean),\n    \"best_cv_auc\": float(grid_search.best_score_),\n    \"best_params\": dict(grid_search.best_params_),\n    \"credit_test_auc\": float(\n        credit_test_metrics[\"ROC-AUC\"]\n    ),\n    \"image_count\": 13,\n}\n\ndisplay_result_table(\n    \"Notebook 验证汇总（Notebook validation summary）\",\n    [\"检查项\", \"观测值\", \"状态\"],\n    [\n        [\"目标编码防泄漏（OOF < 朴素）\", f'{validation[\"oof_target_corr\"]:.3f} < {validation[\"naive_target_corr\"]:.3f}', \"通过\"],\n        [\"泄漏演示：全量预处理分数虚高\", f'{validation[\"leaky_cv_auc\"]:.3f} vs {validation[\"correct_cv_auc\"]:.3f}', \"通过\"],\n        [\"特征工程提升 CV AUC\", f'{validation[\"baseline_cv_auc\"]:.4f} → {validation[\"engineered_cv_auc\"]:.4f}', \"通过\"],\n        [\"网格搜索最优 CV AUC\", f'{validation[\"best_cv_auc\"]:.4f}', \"通过\"],\n        [\"信用卡测试集 ROC-AUC\", f'{validation[\"credit_test_auc\"]:.4f}', \"通过\"],\n        [\"已执行图表输出\", f'{validation[\"image_count\"]}', \"通过\"],\n    ],\n    hidden_comment=\"VALIDATION \" + json.dumps(\n        validation, ensure_ascii=False, sort_keys=True\n    ),\n)"
