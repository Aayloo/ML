   "source": "from sklearn.metrics import (\n    ConfusionMatrixDisplay,\n    accuracy_score,\n    f1_score,\n    precision_score,\n    recall_score,\n    roc_auc_score,\n    roc_curve,\n)\n\n\ndef evaluate_classifier(y_true, y_pred, y_probability):\n    return {\n        \"Accuracy\": accuracy_score(y_true, y_pred),\n        \"Precision\": precision_score(y_true, y_pred),\n        \"Recall\": recall_score(y_true, y_pred),\n        \"F1\": f1_score(y_true, y_pred),\n        \"ROC-AUC\": roc_auc_score(\n            y_true,\n            y_probability,\n        ),\n    }\n\n\nbest_pipeline = grid_search.best_estimator_\ncredit_pred = best_pipeline.predict(credit_X_test)\ncredit_probability = best_pipeline.predict_proba(\n    credit_X_test\n)[:, 1]\ncredit_test_metrics = evaluate_classifier(\n    credit_y_test,\n    credit_pred,\n    credit_probability,\n)\n\nprint(\"最优模型测试集指标（信用卡违约）:\")\nfor name, value in credit_test_metrics.items():\n    print(f\"{name}: {value:.4f}\")\n\ndisplay_result_table(\n    \"信用卡违约：完整流程最优模型（test metrics）\",\n    [\"指标\", \"数值\"],\n    [\n        [\"Accuracy\", f\"{credit_test_metrics['Accuracy']:.4f}\"],\n        [\"Precision\", f\"{credit_test_metrics['Precision']:.4f}\"],\n        [\"Recall\", f\"{credit_test_metrics['Recall']:.4f}\"],\n        [\"F1\", f\"{credit_test_metrics['F1']:.4f}\"],\n        [\"ROC-AUC\", f\"{credit_test_metrics['ROC-AUC']:.4f}\"],\n    ],\n)\n\nfig, axes = plt.subplots(1, 2, figsize=(11.2, 4.7))\nConfusionMatrixDisplay.from_predictions(\n    credit_y_test,\n    credit_pred,\n    display_labels=[\"No default\", \"Default\"],\n    cmap=\"Blues\",\n    colorbar=False,\n    ax=axes[0],\n)\naxes[0].set_title(\"Best Model: Confusion Matrix\")\naxes[0].grid(False)\n\nfalse_positive_rate, true_positive_rate, _ = roc_curve(\n    credit_y_test,\n    credit_probability,\n)\naxes[1].plot(\n    false_positive_rate,\n    true_positive_rate,\n    linewidth=2.2,\n    label=(\n        \"Feature-engineered LR \"\n        f\"(AUC={credit_test_metrics['ROC-AUC']:.3f})\"\n    ),\n)\naxes[1].plot(\n    [0, 1],\n    [0, 1],\n    \"--\",\n    color=\"gray\",\n    label=\"Random classifier\",\n)\naxes[1].set(\n    xlabel=\"False Positive Rate\",\n    ylabel=\"True Positive Rate\",\n    title=\"Credit Card Default: ROC Curve\",\n)\naxes[1].legend(frameon=False)\naxes[1].grid(alpha=0.2)\nplt.show()"
  },
