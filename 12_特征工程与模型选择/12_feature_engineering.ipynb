   "source": "baseline_pipeline = Pipeline([\n    (\"scaler\", StandardScaler()),\n    (\n        \"classifier\",\n        LogisticRegression(\n            solver=\"liblinear\",\n            max_iter=2000,\n            random_state=42,\n        ),\n    ),\n])\n\nbaseline_scores = cross_val_score(\n    baseline_pipeline,\n    raw_X_train,\n    raw_y_train,\n    cv=5,\n    scoring=\"roc_auc\",\n)\nbaseline_cv_mean = baseline_scores.mean()\nprint(\"基线（不做特征工程）5 折 ROC-AUC:\", np.round(\n    baseline_scores, 4\n))\nprint(\"基线平均 ROC-AUC:\", round(baseline_cv_mean, 4))"
