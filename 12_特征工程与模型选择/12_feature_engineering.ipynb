   ],
   "source": "def add_engineered_features(frame):\n    result = frame.copy()\n    pay_columns = [\"PAY_0\", \"PAY_2\", \"PAY_3\", \"PAY_4\", \"PAY_5\", \"PAY_6\"]\n    bill_columns = [f\"BILL_AMT{i}\" for i in range(1, 7)]\n    pay_amount_columns = [f\"PAY_AMT{i}\" for i in range(1, 7)]\n\n    # 窗口聚合：最近 6 个月逾期次数与最坏延迟\n    result[\"recent_delinquencies\"] = (\n        result[pay_columns] > 0\n    ).sum(axis=1)\n    result[\"worst_delay\"] = result[pay_columns].max(axis=1)\n\n    # 比率：平均还款率（还款/账单）\n    ratios = pd.DataFrame({\n        f\"pay_ratio_{i}\": (\n            result[f\"PAY_AMT{i}\"]\n            / (result[f\"BILL_AMT{i}\"].abs() + 1.0)\n        )\n        for i in range(1, 7)\n    })\n    result[\"mean_payment_ratio\"] = ratios.mean(axis=1)\n\n    # 波动：账单金额跨月标准差\n    result[\"bill_volatility\"] = result[bill_columns].std(axis=1)\n\n    # 利用率：当月账单占额度的比例\n    result[\"credit_utilization\"] = (\n        result[\"BILL_AMT1\"].abs()\n        / (result[\"LIMIT_BAL\"] + 1.0)\n    )\n    return result\n\n\n# 同时完成 EDUCATION 特殊值清洗\nX_credit_engineered = X_credit_all.copy()\nX_credit_engineered[\"EDUCATION\"] = X_credit_engineered[\n    \"EDUCATION\"\n].replace({0: 4, 5: 4, 6: 4})\nX_credit_engineered = add_engineered_features(\n    X_credit_engineered\n)\n\nnew_features = [\n    \"recent_delinquencies\",\n    \"worst_delay\",\n    \"mean_payment_ratio\",\n    \"bill_volatility\",\n    \"credit_utilization\",\n]\ncorrelations = X_credit_engineered[new_features].corrwith(\n    y_credit_all\n).sort_values(ascending=False)\nprint(\"新特征与违约标签的相关性:\")\nprint(correlations.round(4))\n\ndisplay_result_table(\n    \"特征构造：新特征与目标的相关系数\",\n    [\"特征\", \"相关系数\"],\n    [\n        [name, f\"{correlations[name]:.4f}\"]\n        for name in correlations.index\n    ],\n)"
  },
