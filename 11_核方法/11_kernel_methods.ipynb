   "source": "from sklearn.datasets import (\n    load_diabetes,\n    load_digits,\n    make_circles,\n)\nfrom sklearn.decomposition import KernelPCA, PCA\nfrom sklearn.kernel_ridge import KernelRidge\nfrom sklearn.linear_model import LinearRegression\nfrom sklearn.metrics import accuracy_score\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.neighbors import KNeighborsClassifier\nfrom sklearn.svm import SVC\n\nsklearn_kr = KernelRidge(\n    kernel=\"rbf\",\n    gamma=0.8,\n    alpha=0.05,\n)\nsklearn_kr.fit(manual_X_train, manual_y_train)\nsklearn_pred = sklearn_kr.predict(manual_X_test)\n\ncorrelation = np.corrcoef(\n    manual_pred,\n    sklearn_pred,\n)[0, 1]\nmax_diff = np.max(\n    np.abs(manual_pred - sklearn_pred)\n)\nprint(\"手写与 sklearn 预测相关系数:\", round(correlation, 8))\nprint(\"最大绝对差:\", max_diff)\n\nplt.figure(figsize=(6.8, 5.0))\nplt.scatter(\n    manual_pred,\n    sklearn_pred,\n    s=22,\n    color=\"#4C78A8\",\n    edgecolor=\"white\",\n    linewidth=0.5,\n    zorder=3,\n)\nlims = [\n    min(manual_pred.min(), sklearn_pred.min()),\n    max(manual_pred.max(), sklearn_pred.max()),\n]\nplt.plot(\n    lims,\n    lims,\n    \"--\",\n    color=\"gray\",\n    linewidth=1.4,\n    label=\"y = x\",\n)\nplt.xlabel(\"Handwritten prediction\")\nplt.ylabel(\"sklearn prediction\")\nplt.title(\"Kernel Ridge: Handwritten vs. sklearn\")\nplt.legend(frameon=False)\nplt.grid(alpha=0.2)\nplt.show()"
  },
