   "source": "diabetes = load_diabetes()\n(\n    diabetes_X_train,\n    diabetes_X_test,\n    diabetes_y_train,\n    diabetes_y_test,\n) = train_test_split(\n    diabetes.data,\n    diabetes.target,\n    test_size=0.2,\n    random_state=42,\n)\n\ndiabetes_linear = LinearRegression()\ndiabetes_linear.fit(diabetes_X_train, diabetes_y_train)\ndiabetes_kernel_ridge = KernelRidge(\n    kernel=\"rbf\",\n    gamma=0.2,\n    alpha=0.05,\n)\ndiabetes_kernel_ridge.fit(\n    diabetes_X_train,\n    diabetes_y_train,\n)\n\n\ndef regression_metrics(y_true, y_pred):\n    mse = np.mean((y_true - y_pred) ** 2)\n    return {\n        \"MSE\": mse,\n        \"RMSE\": float(np.sqrt(mse)),\n        \"MAE\": np.mean(\n            np.abs(y_true - y_pred)\n        ),\n        \"R2\": 1 - (\n            np.sum((y_true - y_pred) ** 2)\n            / np.sum(\n                (y_true - y_true.mean()) ** 2\n            )\n        ),\n    }\n\n\ndiabetes_linear_metrics = regression_metrics(\n    diabetes_y_test,\n    diabetes_linear.predict(diabetes_X_test),\n)\ndiabetes_kr_metrics = regression_metrics(\n    diabetes_y_test,\n    diabetes_kernel_ridge.predict(diabetes_X_test),\n)\n\nprint(\n    \"线性回归 R²:\",\n    round(diabetes_linear_metrics[\"R2\"], 4),\n)\nprint(\n    \"核岭回归 R²:\",\n    round(diabetes_kr_metrics[\"R2\"], 4),\n)\n\ndisplay_result_table(\n    \"糖尿病：线性回归 vs RBF 核岭回归（test metrics）\",\n    [\"指标\", \"线性回归\", \"核岭回归\"],\n    [\n        [\"MSE\", f\"{diabetes_linear_metrics['MSE']:.1f}\", f\"{diabetes_kr_metrics['MSE']:.1f}\"],\n        [\"RMSE\", f\"{diabetes_linear_metrics['RMSE']:.1f}\", f\"{diabetes_kr_metrics['RMSE']:.1f}\"],\n        [\"MAE\", f\"{diabetes_linear_metrics['MAE']:.1f}\", f\"{diabetes_kr_metrics['MAE']:.1f}\"],\n        [\"R²\", f\"{diabetes_linear_metrics['R2']:.3f}\", f\"{diabetes_kr_metrics['R2']:.3f}\"],\n    ],\n)"
  },
