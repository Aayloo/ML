   ],
   "source": "kpca_X, kpca_y = make_circles(\n    n_samples=400,\n    noise=0.05,\n    factor=0.3,\n    random_state=42,\n)\n(\n    kpca_X_train,\n    kpca_X_test,\n    kpca_y_train,\n    kpca_y_test,\n) = train_test_split(\n    kpca_X,\n    kpca_y,\n    test_size=0.2,\n    stratify=kpca_y,\n    random_state=42,\n)\n\ncircles_pca = PCA(n_components=2).fit(\n    kpca_X_train\n)\ncircles_kpca = KernelPCA(\n    n_components=2,\n    kernel=\"rbf\",\n    gamma=10,\n).fit(kpca_X_train)\n\ncircles_pca_train = circles_pca.transform(\n    kpca_X_train\n)\ncircles_kpca_train = circles_kpca.transform(\n    kpca_X_train\n)\n\nlinear_on_pca = SVC(kernel=\"linear\", C=10)\nlinear_on_pca.fit(\n    circles_pca_train,\n    kpca_y_train,\n)\nlinear_on_kpca = SVC(kernel=\"linear\", C=10)\nlinear_on_kpca.fit(\n    circles_kpca_train,\n    kpca_y_train,\n)\n\ncircles_pca_test = circles_pca.transform(\n    kpca_X_test\n)\ncircles_kpca_test = circles_kpca.transform(\n    kpca_X_test\n)\npca_linear_accuracy = accuracy_score(\n    kpca_y_test,\n    linear_on_pca.predict(circles_pca_test),\n)\nkpca_linear_accuracy = accuracy_score(\n    kpca_y_test,\n    linear_on_kpca.predict(circles_kpca_test),\n)\nprint(\n    \"线性 PCA 投影 + 线性分类准确率:\",\n    round(pca_linear_accuracy, 4),\n)\nprint(\n    \"核 PCA 投影 + 线性分类准确率:\",\n    round(kpca_linear_accuracy, 4),\n)\n\nfig, axes = plt.subplots(1, 2, figsize=(11.2, 4.7))\nfor ax, Z, title in [\n    (\n        axes[0],\n        circles_pca_train,\n        \"Linear PCA: 2D projection\",\n    ),\n    (\n        axes[1],\n        circles_kpca_train,\n        \"RBF KernelPCA: 2D projection\",\n    ),\n]:\n    ax.scatter(\n        Z[kpca_y_train == 0, 0],\n        Z[kpca_y_train == 0, 1],\n        s=14,\n        color=\"#4C78A8\",\n        edgecolor=\"white\",\n        linewidth=0.4,\n    )\n    ax.scatter(\n        Z[kpca_y_train == 1, 0],\n        Z[kpca_y_train == 1, 1],\n        s=14,\n        color=\"#E45756\",\n        edgecolor=\"white\",\n        linewidth=0.4,\n    )\n    ax.set(\n        title=title,\n        xlabel=\"Component 1\",\n        ylabel=\"Component 2\",\n    )\n    ax.grid(alpha=0.2)\nfig.tight_layout()\nplt.show()"
