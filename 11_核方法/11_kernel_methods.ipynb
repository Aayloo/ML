   ],
   "source": "from IPython.display import HTML, display\n\n\ndef display_result_table(title, headers, rows, hidden_comment=\"\"):\n    header_html = \"\".join(\n        f'<th style=\"padding:8px 12px;text-align:left;background:#eef3ff\">{header}</th>'\n        for header in headers\n    )\n    row_html = \"\".join(\n        \"<tr>\" + \"\".join(\n            f'<td style=\"padding:7px 12px;border-top:1px solid #dde3ee\">{value}</td>'\n            for value in row\n        ) + \"</tr>\"\n        for row in rows\n    )\n    comment_html = f\"<!-- {hidden_comment} -->\" if hidden_comment else \"\"\n    display(HTML(\n        f'<div style=\"max-width:780px\"><h4>{title}</h4>'\n        f'<table style=\"border-collapse:collapse;width:100%;font-size:14px\">'\n        f'<thead><tr>{header_html}</tr></thead><tbody>{row_html}</tbody></table>'\n        f'{comment_html}</div>'\n    ))\n\n\nmanual_model = KernelRidgeScratch(\n    gamma=0.8,\n    alpha=0.05,\n).fit(manual_X_train, manual_y_train)\nmanual_pred = manual_model.predict(manual_X_test)\n\nmanual_mse = np.mean(\n    (manual_y_test - manual_pred) ** 2\n)\nmanual_rmse = np.sqrt(manual_mse)\nmanual_mae = np.mean(\n    np.abs(manual_y_test - manual_pred)\n)\nmanual_ss_res = np.sum(\n    (manual_y_test - manual_pred) ** 2\n)\nmanual_ss_tot = np.sum(\n    (manual_y_test - manual_y_test.mean()) ** 2\n)\nmanual_r2 = 1 - manual_ss_res / manual_ss_tot\n\nprint(\"手写核岭回归: gamma = 0.8, alpha = 0.05\")\nprint(\n    \"测试集: MSE =\",\n    round(manual_mse, 3),\n    \", RMSE =\",\n    round(manual_rmse, 3),\n    \", MAE =\",\n    round(manual_mae, 3),\n    \", R² =\",\n    round(manual_r2, 3),\n)\n\ndisplay_result_table(\n    \"手写核岭回归：测试集指标（test metrics）\",\n    [\"指标\", \"数值\"],\n    [\n        [\"MSE\", f\"{manual_mse:.3f}\"],\n        [\"RMSE\", f\"{manual_rmse:.3f}\"],\n        [\"MAE\", f\"{manual_mae:.3f}\"],\n        [\"R²\", f\"{manual_r2:.3f}\"],\n    ],\n)\n\nxs = np.linspace(-3, 3, 300)\ngamma_values = [0.05, 0.8, 30]\nfig, axes = plt.subplots(1, 3, figsize=(13.5, 4.0))\nfor ax, gamma in zip(axes, gamma_values):\n    model = KernelRidgeScratch(\n        gamma=gamma,\n        alpha=0.05,\n    ).fit(manual_X_train, manual_y_train)\n    fit_curve = model.predict(xs.reshape(-1, 1))\n    ax.scatter(\n        manual_X_train,\n        manual_y_train,\n        s=12,\n        color=\"#4C78A8\",\n        edgecolor=\"white\",\n        linewidth=0.4,\n        zorder=3,\n    )\n    ax.plot(\n        xs,\n        np.sin(2.0 * xs) + 0.5 * xs,\n        \"--\",\n        color=\"#202124\",\n        linewidth=1.3,\n    )\n    ax.plot(\n        xs,\n        fit_curve,\n        color=\"#E45756\",\n        linewidth=2.2,\n    )\n    ax.set(title=f\"gamma = {gamma}\", xlabel=\"x\")\n    ax.grid(alpha=0.2)\nfig.tight_layout()\nplt.show()"
  },
