   "source": "# 复现图 1：特征映射 x -> (x, x^2)\nimport numpy as np\nimport matplotlib.pyplot as plt\n\nrng_fig = np.random.default_rng(5)\nn_fig = 50\nx_mid = rng_fig.uniform(-1.4, 1.4, n_fig)\nx_side = np.r_[\n    rng_fig.uniform(-3.0, -1.6, n_fig),\n    rng_fig.uniform(1.6, 3.0, n_fig),\n]\ny_mid = np.zeros(n_fig)\ny_side = np.ones(2 * n_fig)\n\nfig, axes = plt.subplots(1, 2, figsize=(11.2, 4.4))\naxes[0].scatter(\n    x_mid,\n    y_mid,\n    s=16,\n    color=\"#4C78A8\",\n    edgecolor=\"white\",\n    linewidth=0.4,\n    zorder=3,\n)\naxes[0].scatter(\n    x_side,\n    y_side,\n    s=16,\n    color=\"#E45756\",\n    edgecolor=\"white\",\n    linewidth=0.4,\n    zorder=3,\n)\naxes[0].set(\n    xlabel=\"x\",\n    title=\"1D: no single threshold separates\",\n    xlim=(-3.4, 3.4),\n    ylim=(-0.2, 1.2),\n)\naxes[0].grid(alpha=0.2)\n\naxes[1].scatter(\n    x_mid,\n    x_mid ** 2,\n    s=16,\n    color=\"#4C78A8\",\n    edgecolor=\"white\",\n    linewidth=0.4,\n    zorder=3,\n)\naxes[1].scatter(\n    x_side,\n    x_side ** 2,\n    s=16,\n    color=\"#E45756\",\n    edgecolor=\"white\",\n    linewidth=0.4,\n    zorder=3,\n)\naxes[1].axhline(\n    2.2,\n    color=\"#202124\",\n    linestyle=\"--\",\n    linewidth=1.6,\n)\naxes[1].set(\n    xlabel=\"x\",\n    ylabel=\"x^2\",\n    title=\"phi(x) = (x, x^2): linearly separable\",\n    xlim=(-3.4, 3.4),\n)\naxes[1].grid(alpha=0.2)\nfig.tight_layout()\nplt.show()"
