   "source": "gamma_values = [0.1, 1, 10]\nfig, axes = plt.subplots(1, 3, figsize=(13.5, 4.3))\nfor ax, gamma in zip(axes, gamma_values):\n    model = SVC(\n        kernel=\"rbf\",\n        C=10,\n        gamma=gamma,\n        random_state=42,\n    )\n    model.fit(circles_X_train, circles_y_train)\n    accuracy = accuracy_score(\n        circles_y_test,\n        model.predict(circles_X_test),\n    )\n    plot_decision_boundary(\n        ax,\n        circles_X_train,\n        circles_y_train,\n        model,\n        f\"gamma = {gamma} (accuracy={accuracy:.3f})\",\n    )\nfig.tight_layout()\nplt.show()"
