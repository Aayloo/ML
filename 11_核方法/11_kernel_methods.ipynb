   "source": "# 复现图 3：核岭回归拟合非线性曲线\ndef rbf_pairwise(X1, X2, gamma):\n    distance_sq = (\n        (X1[:, None, :] - X2[None, :, :]) ** 2\n    ).sum(axis=-1)\n    return np.exp(-gamma * distance_sq)\n\n\ndef kernel_ridge_predict(\n    X_train,\n    y_train,\n    X_test,\n    gamma,\n    alpha,\n):\n    K = rbf_pairwise(X_train, X_train, gamma)\n    n = len(X_train)\n    coefficients = np.linalg.solve(\n        K + alpha * np.eye(n),\n        y_train,\n    )\n    return rbf_pairwise(\n        X_test,\n        X_train,\n        gamma,\n    ) @ coefficients\n\n\nrng_kr = np.random.default_rng(11)\nx_kr = np.sort(rng_kr.uniform(-3, 3, 120))\ny_kr = (\n    np.sin(2.0 * x_kr)\n    + 0.5 * x_kr\n    + rng_kr.normal(0, 0.25, 120)\n)\nxs_kr = np.linspace(-3, 3, 300)\nprediction_kr = kernel_ridge_predict(\n    x_kr.reshape(-1, 1),\n    y_kr,\n    xs_kr.reshape(-1, 1),\n    gamma=0.8,\n    alpha=0.05,\n)\n\nfig, ax = plt.subplots(figsize=(7.0, 4.5))\nax.scatter(\n    x_kr,\n    y_kr,\n    s=14,\n    color=\"#4C78A8\",\n    edgecolor=\"white\",\n    linewidth=0.4,\n    zorder=3,\n)\nax.plot(\n    xs_kr,\n    np.sin(2.0 * xs_kr) + 0.5 * xs_kr,\n    \"--\",\n    color=\"#202124\",\n    linewidth=1.8,\n    label=\"True function\",\n)\nax.plot(\n    xs_kr,\n    prediction_kr,\n    color=\"#E45756\",\n    linewidth=2.4,\n    label=\"Kernel ridge fit\",\n)\nax.set(\n    xlabel=\"Feature x\",\n    ylabel=\"Target y\",\n    title=\"Kernel Ridge Regression with RBF Kernel\",\n)\nax.legend(frameon=False)\nax.grid(alpha=0.2)\nplt.show()"
