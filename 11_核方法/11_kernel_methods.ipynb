   ],
   "source": "circles_X, circles_y = make_circles(\n    n_samples=300,\n    noise=0.08,\n    factor=0.5,\n    random_state=42,\n)\n(\n    circles_X_train,\n    circles_X_test,\n    circles_y_train,\n    circles_y_test,\n) = train_test_split(\n    circles_X,\n    circles_y,\n    test_size=0.2,\n    stratify=circles_y,\n    random_state=42,\n)\n\nlinear_svc = SVC(\n    kernel=\"linear\",\n    C=10,\n    random_state=42,\n)\nlinear_svc.fit(circles_X_train, circles_y_train)\nrbf_svc = SVC(\n    kernel=\"rbf\",\n    C=10,\n    gamma=1,\n    random_state=42,\n)\nrbf_svc.fit(circles_X_train, circles_y_train)\n\nlinear_accuracy = accuracy_score(\n    circles_y_test,\n    linear_svc.predict(circles_X_test),\n)\nrbf_accuracy = accuracy_score(\n    circles_y_test,\n    rbf_svc.predict(circles_X_test),\n)\nprint(\"线性核 SVM 测试准确率:\", round(linear_accuracy, 4))\nprint(\"RBF 核 SVM 测试准确率:\", round(rbf_accuracy, 4))\n\n\ndef plot_decision_boundary(ax, X, y, model, title):\n    margin = 0.3\n    x1_min = X[:, 0].min() - margin\n    x1_max = X[:, 0].max() + margin\n    x2_min = X[:, 1].min() - margin\n    x2_max = X[:, 1].max() + margin\n    grid_x1, grid_x2 = np.meshgrid(\n        np.linspace(x1_min, x1_max, 220),\n        np.linspace(x2_min, x2_max, 220),\n    )\n    grid = np.c_[grid_x1.ravel(), grid_x2.ravel()]\n    prediction_grid = model.predict(grid).reshape(\n        grid_x1.shape\n    )\n    ax.contourf(\n        grid_x1,\n        grid_x2,\n        prediction_grid,\n        levels=[-0.5, 0.5, 1.5],\n        colors=[\"#dbe5f1\", \"#f7ddda\"],\n        alpha=0.7,\n    )\n    ax.scatter(\n        X[y == 0, 0],\n        X[y == 0, 1],\n        s=14,\n        color=\"#4C78A8\",\n        edgecolor=\"white\",\n        linewidth=0.4,\n        zorder=3,\n    )\n    ax.scatter(\n        X[y == 1, 0],\n        X[y == 1, 1],\n        s=14,\n        color=\"#E45756\",\n        edgecolor=\"white\",\n        linewidth=0.4,\n        zorder=3,\n    )\n    ax.set(title=title, xlabel=\"x1\", ylabel=\"x2\")\n    ax.grid(alpha=0.2)\n\n\nfig, axes = plt.subplots(1, 2, figsize=(11.2, 4.7))\nplot_decision_boundary(\n    axes[0],\n    circles_X_train,\n    circles_y_train,\n    linear_svc,\n    f\"Linear SVM (accuracy={linear_accuracy:.3f})\",\n)\nplot_decision_boundary(\n    axes[1],\n    circles_X_train,\n    circles_y_train,\n    rbf_svc,\n    f\"RBF SVM (accuracy={rbf_accuracy:.3f})\",\n)\nfig.tight_layout()\nplt.show()"
