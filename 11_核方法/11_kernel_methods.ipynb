   "source": "import json\n\nall_values = [\n    manual_mse,\n    manual_rmse,\n    manual_mae,\n    manual_r2,\n    correlation,\n    max_diff,\n    linear_accuracy,\n    rbf_accuracy,\n    diabetes_linear_metrics[\"R2\"],\n    diabetes_kr_metrics[\"R2\"],\n    pca_linear_accuracy,\n    kpca_linear_accuracy,\n]\nassert np.all(np.isfinite(all_values))\nassert manual_r2 > 0.85\nassert correlation > 0.999\nassert rbf_accuracy > 0.9\nassert rbf_accuracy > linear_accuracy\nassert diabetes_kr_metrics[\"R2\"] > 0.35\nassert kpca_linear_accuracy > 0.9\nassert kpca_linear_accuracy > pca_linear_accuracy\n\nvalidation = {\n    \"manual_r2\": float(manual_r2),\n    \"correlation\": float(correlation),\n    \"max_diff\": float(max_diff),\n    \"linear_accuracy\": float(linear_accuracy),\n    \"rbf_accuracy\": float(rbf_accuracy),\n    \"diabetes_linear_r2\": float(\n        diabetes_linear_metrics[\"R2\"]\n    ),\n    \"diabetes_kr_r2\": float(\n        diabetes_kr_metrics[\"R2\"]\n    ),\n    \"pca_linear_accuracy\": float(pca_linear_accuracy),\n    \"kpca_linear_accuracy\": float(kpca_linear_accuracy),\n    \"image_count\": 10,\n}\n\ndisplay_result_table(\n    \"Notebook 验证汇总（Notebook validation summary）\",\n    [\"检查项\", \"观测值\", \"状态\"],\n    [\n        [\"手写核岭回归 R²\", f'{validation[\"manual_r2\"]:.3f}', \"通过\"],\n        [\"手写/sklearn 一致性\", f'{validation[\"correlation\"]:.6f}', \"通过\"],\n        [\"环状数据线性核准确率\", f'{validation[\"linear_accuracy\"]:.3f}', \"通过\"],\n        [\"环状数据 RBF 核准确率\", f'{validation[\"rbf_accuracy\"]:.3f}', \"通过\"],\n        [\"糖尿病核岭回归 R²\", f'{validation[\"diabetes_kr_r2\"]:.3f}', \"通过\"],\n        [\"核 PCA 投影线性可分准确率\", f'{validation[\"kpca_linear_accuracy\"]:.3f}', \"通过\"],\n        [\"已执行图表输出\", f'{validation[\"image_count\"]}', \"通过\"],\n    ],\n    hidden_comment=\"VALIDATION \" + json.dumps(\n        validation, ensure_ascii=False, sort_keys=True\n    ),\n)"
