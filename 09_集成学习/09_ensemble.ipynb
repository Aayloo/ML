   "source": "diabetes = load_diabetes()\n(\n    diabetes_X_train,\n    diabetes_X_test,\n    diabetes_y_train,\n    diabetes_y_test,\n) = train_test_split(\n    diabetes.data,\n    diabetes.target,\n    test_size=0.2,\n    random_state=42,\n)\n\ndiabetes_rf = RandomForestRegressor(\n    n_estimators=300,\n    random_state=42,\n)\ndiabetes_rf.fit(diabetes_X_train, diabetes_y_train)\n\ndiabetes_gbdt = GradientBoostingRegressor(random_state=42)\ndiabetes_gbdt.fit(diabetes_X_train, diabetes_y_train)\n\ndiabetes_xgb = XGBRegressor(\n    random_state=42,\n    verbosity=0,\n)\ndiabetes_xgb.fit(diabetes_X_train, diabetes_y_train)\n\nregressors = {\n    \"RandomForest\": diabetes_rf,\n    \"GBDT\": diabetes_gbdt,\n    \"XGBoost\": diabetes_xgb,\n}\ndiabetes_metrics = {}\nfor name, model in regressors.items():\n    prediction = model.predict(diabetes_X_test)\n    mse = mean_squared_error(\n        diabetes_y_test,\n        prediction,\n    )\n    diabetes_metrics[name] = {\n        \"MSE\": mse,\n        \"RMSE\": float(np.sqrt(mse)),\n        \"MAE\": mean_absolute_error(\n            diabetes_y_test,\n            prediction,\n        ),\n        \"R2\": r2_score(\n            diabetes_y_test,\n            prediction,\n        ),\n    }\n    print(\n        name,\n        \": R² =\",\n        round(diabetes_metrics[name][\"R2\"], 4),\n        \", RMSE =\",\n        round(diabetes_metrics[name][\"RMSE\"], 4),\n    )\n\ndisplay_result_table(\n    \"糖尿病：三种集成回归对比（test metrics）\",\n    [\"指标\", \"RandomForest\", \"GBDT\", \"XGBoost\"],\n    [\n        [\"MSE\", f\"{diabetes_metrics['RandomForest']['MSE']:.1f}\", f\"{diabetes_metrics['GBDT']['MSE']:.1f}\", f\"{diabetes_metrics['XGBoost']['MSE']:.1f}\"],\n        [\"RMSE\", f\"{diabetes_metrics['RandomForest']['RMSE']:.1f}\", f\"{diabetes_metrics['GBDT']['RMSE']:.1f}\", f\"{diabetes_metrics['XGBoost']['RMSE']:.1f}\"],\n        [\"MAE\", f\"{diabetes_metrics['RandomForest']['MAE']:.1f}\", f\"{diabetes_metrics['GBDT']['MAE']:.1f}\", f\"{diabetes_metrics['XGBoost']['MAE']:.1f}\"],\n        [\"R²\", f\"{diabetes_metrics['RandomForest']['R2']:.3f}\", f\"{diabetes_metrics['GBDT']['R2']:.3f}\", f\"{diabetes_metrics['XGBoost']['R2']:.3f}\"],\n    ],\n)"
  },
