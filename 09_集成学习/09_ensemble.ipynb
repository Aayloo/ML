      "text/html": "<div style=\"max-width:780px\"><h4>乳腺癌：单棵决策树 vs 随机森林（test metrics）</h4><table style=\"border-collapse:collapse;width:100%;font-size:14px\"><thead><tr><th style=\"padding:8px 12px;text-align:left;background:#eef3ff\">指标</th><th style=\"padding:8px 12px;text-align:left;background:#eef3ff\">单棵决策树</th><th style=\"padding:8px 12px;text-align:left;background:#eef3ff\">随机森林</th></tr></thead><tbody><tr><td style=\"padding:7px 12px;border-top:1px solid #dde3ee\">Accuracy</td><td style=\"padding:7px 12px;border-top:1px solid #dde3ee\">0.9123</td><td style=\"padding:7px 12px;border-top:1px solid #dde3ee\">0.9561</td></tr><tr><td style=\"padding:7px 12px;border-top:1px solid #dde3ee\">Precision</td><td style=\"padding:7px 12px;border-top:1px solid #dde3ee\">0.9559</td><td style=\"padding:7px 12px;border-top:1px solid #dde3ee\">0.9589</td></tr><tr><td style=\"padding:7px 12px;border-top:1px solid #dde3ee\">Recall</td><td style=\"padding:7px 12px;border-top:1px solid #dde3ee\">0.9028</td><td style=\"padding:7px 12px;border-top:1px solid #dde3ee\">0.9722</td></tr><tr><td style=\"padding:7px 12px;border-top:1px solid #dde3ee\">F1</td><td style=\"padding:7px 12px;border-top:1px solid #dde3ee\">0.9286</td><td style=\"padding:7px 12px;border-top:1px solid #dde3ee\">0.9655</td></tr><tr><td style=\"padding:7px 12px;border-top:1px solid #dde3ee\">ROC-AUC</td><td style=\"padding:7px 12px;border-top:1px solid #dde3ee\">0.9157</td><td style=\"padding:7px 12px;border-top:1px solid #dde3ee\">0.9931</td></tr></tbody></table></div>"
     }
    }
   ],
   "source": "from sklearn.datasets import (\n    load_breast_cancer,\n    load_diabetes,\n)\nfrom sklearn.ensemble import (\n    GradientBoostingClassifier,\n    GradientBoostingRegressor,\n    RandomForestClassifier,\n    RandomForestRegressor,\n)\nfrom sklearn.metrics import (\n    ConfusionMatrixDisplay,\n    accuracy_score,\n    f1_score,\n    mean_absolute_error,\n    mean_squared_error,\n    precision_score,\n    r2_score,\n    recall_score,\n    roc_auc_score,\n    roc_curve,\n)\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.tree import DecisionTreeClassifier\nfrom xgboost import XGBClassifier, XGBRegressor\n\n\ndef evaluate_classifier(y_true, y_pred, y_probability):\n    return {\n        \"Accuracy\": accuracy_score(y_true, y_pred),\n        \"Precision\": precision_score(y_true, y_pred),\n        \"Recall\": recall_score(y_true, y_pred),\n        \"F1\": f1_score(y_true, y_pred),\n        \"ROC-AUC\": roc_auc_score(\n            y_true,\n            y_probability,\n        ),\n    }\n\n\ncancer = load_breast_cancer()\n(\n    cancer_X_train,\n    cancer_X_test,\n    cancer_y_train,\n    cancer_y_test,\n) = train_test_split(\n    cancer.data,\n    cancer.target,\n    test_size=0.2,\n    stratify=cancer.target,\n    random_state=42,\n)\n\nsingle_tree = DecisionTreeClassifier(random_state=42)\nsingle_tree.fit(cancer_X_train, cancer_y_train)\n\nrandom_forest = RandomForestClassifier(\n    n_estimators=200,\n    random_state=42,\n)\nrandom_forest.fit(cancer_X_train, cancer_y_train)\n\ntree_pred = single_tree.predict(cancer_X_test)\nforest_pred = random_forest.predict(cancer_X_test)\ntree_metrics = evaluate_classifier(\n    cancer_y_test,\n    tree_pred,\n    single_tree.predict_proba(cancer_X_test)[:, 1],\n)\nforest_metrics = evaluate_classifier(\n    cancer_y_test,\n    forest_pred,\n    random_forest.predict_proba(cancer_X_test)[:, 1],\n)\n\nprint(\"单棵决策树\")\nfor name, value in tree_metrics.items():\n    print(f\"{name}: {value:.4f}\")\nprint(\"随机森林\")\nfor name, value in forest_metrics.items():\n    print(f\"{name}: {value:.4f}\")\n\ndisplay_result_table(\n    \"乳腺癌：单棵决策树 vs 随机森林（test metrics）\",\n    [\"指标\", \"单棵决策树\", \"随机森林\"],\n    [\n        [\"Accuracy\", f\"{tree_metrics['Accuracy']:.4f}\", f\"{forest_metrics['Accuracy']:.4f}\"],\n        [\"Precision\", f\"{tree_metrics['Precision']:.4f}\", f\"{forest_metrics['Precision']:.4f}\"],\n        [\"Recall\", f\"{tree_metrics['Recall']:.4f}\", f\"{forest_metrics['Recall']:.4f}\"],\n        [\"F1\", f\"{tree_metrics['F1']:.4f}\", f\"{forest_metrics['F1']:.4f}\"],\n        [\"ROC-AUC\", f\"{tree_metrics['ROC-AUC']:.4f}\", f\"{forest_metrics['ROC-AUC']:.4f}\"],\n    ],\n)"
  },
