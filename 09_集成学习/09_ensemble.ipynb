   "source": "# 复现图 1：Bagging 平均降低方差\nimport numpy as np\nimport matplotlib.pyplot as plt\n\nrng_fig = np.random.default_rng(42)\nx_fig = np.linspace(-3, 3, 80)\ntrue_w, true_b = 1.2, 0.4\ny_fig = true_w * x_fig + true_b\n\nfig, ax = plt.subplots(figsize=(7.2, 4.5))\nfor seed in range(5):\n    rng_boot = np.random.default_rng(seed)\n    index = rng_boot.integers(0, len(x_fig), size=len(x_fig))\n    xb, yb = x_fig[index], y_fig[index] + rng_boot.normal(0, 0.8, len(x_fig))\n    w, b = np.polyfit(xb, yb, 1)\n    ax.plot(\n        x_fig,\n        w * x_fig + b,\n        color=\"#4C78A8\",\n        alpha=0.45,\n        linewidth=1.4,\n        label=\"Single fit (bootstrap)\" if seed == 0 else None,\n    )\n\nw_sum = b_sum = 0.0\nbag_size = 50\nfor seed in range(bag_size):\n    rng_boot = np.random.default_rng(seed)\n    index = rng_boot.integers(0, len(x_fig), size=len(x_fig))\n    xb, yb = x_fig[index], y_fig[index] + rng_boot.normal(0, 0.8, len(x_fig))\n    w, b = np.polyfit(xb, yb, 1)\n    w_sum += w\n    b_sum += b\nw_avg, b_avg = w_sum / bag_size, b_sum / bag_size\n\nax.plot(\n    x_fig,\n    true_w * x_fig + true_b,\n    color=\"#202124\",\n    linewidth=2.6,\n    linestyle=\"--\",\n    label=\"True line\",\n)\nax.plot(\n    x_fig,\n    w_avg * x_fig + b_avg,\n    color=\"#E45756\",\n    linewidth=2.6,\n    label=\"Bagged average\",\n)\nax.set(\n    xlabel=\"Feature x\",\n    ylabel=\"Target y\",\n    title=\"Bagging: Averaging Reduces Variance\",\n)\nax.legend(frameon=False)\nax.grid(alpha=0.2)\nplt.show()"
  },
