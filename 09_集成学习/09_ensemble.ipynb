   "source": "import os\n\nimport pandas as pd\n\ndata_candidates = [\n    os.path.join(\n        \"08_综合案例\",\n        \"data\",\n        \"default_of_credit_card_clients.csv\",\n    ),\n    os.path.join(\n        \"..\",\n        \"08_综合案例\",\n        \"data\",\n        \"default_of_credit_card_clients.csv\",\n    ),\n]\ncredit_path = next(\n    (p for p in data_candidates if os.path.exists(p)),\n    None,\n)\nassert credit_path is not None, \"未找到信用卡数据，请确认08_综合案例目录存在\"\n\ncredit = pd.read_csv(credit_path)\nX_credit = credit.drop(\n    columns=[\"ID\", \"default_payment_next_month\"]\n)\ny_credit = credit[\"default_payment_next_month\"]\n(\n    credit_X_train,\n    credit_X_test,\n    credit_y_train,\n    credit_y_test,\n) = train_test_split(\n    X_credit,\n    y_credit,\n    test_size=0.2,\n    stratify=y_credit,\n    random_state=42,\n)\n\ngbdt_credit = GradientBoostingClassifier(random_state=42)\ngbdt_credit.fit(credit_X_train, credit_y_train)\ngbdt_credit_pred = gbdt_credit.predict(credit_X_test)\ngbdt_credit_metrics = evaluate_classifier(\n    credit_y_test,\n    gbdt_credit_pred,\n    gbdt_credit.predict_proba(credit_X_test)[:, 1],\n)\n\nxgb_credit = XGBClassifier(\n    random_state=42,\n    eval_metric=\"logloss\",\n    verbosity=0,\n)\nxgb_credit.fit(credit_X_train, credit_y_train)\nxgb_credit_pred = xgb_credit.predict(credit_X_test)\nxgb_credit_metrics = evaluate_classifier(\n    credit_y_test,\n    xgb_credit_pred,\n    xgb_credit.predict_proba(credit_X_test)[:, 1],\n)\n\nprint(\"信用卡违约：30,000 行，特征数:\", X_credit.shape[1])\nprint(\n    \"GBDT: Accuracy =\",\n    round(gbdt_credit_metrics[\"Accuracy\"], 4),\n    \", ROC-AUC =\",\n    round(gbdt_credit_metrics[\"ROC-AUC\"], 4),\n)\nprint(\n    \"XGBoost: Accuracy =\",\n    round(xgb_credit_metrics[\"Accuracy\"], 4),\n    \", ROC-AUC =\",\n    round(xgb_credit_metrics[\"ROC-AUC\"], 4),\n)\n\ndisplay_result_table(\n    \"信用卡违约：GBDT vs XGBoost（test metrics）\",\n    [\"指标\", \"GBDT\", \"XGBoost\"],\n    [\n        [\"Accuracy\", f\"{gbdt_credit_metrics['Accuracy']:.4f}\", f\"{xgb_credit_metrics['Accuracy']:.4f}\"],\n        [\"Precision\", f\"{gbdt_credit_metrics['Precision']:.4f}\", f\"{xgb_credit_metrics['Precision']:.4f}\"],\n        [\"Recall\", f\"{gbdt_credit_metrics['Recall']:.4f}\", f\"{xgb_credit_metrics['Recall']:.4f}\"],\n        [\"F1\", f\"{gbdt_credit_metrics['F1']:.4f}\", f\"{xgb_credit_metrics['F1']:.4f}\"],\n        [\"ROC-AUC\", f\"{gbdt_credit_metrics['ROC-AUC']:.4f}\", f\"{xgb_credit_metrics['ROC-AUC']:.4f}\"],\n    ],\n)"
