   "source": "# 复现图 3：集成规模与测试误差\nrng_e = np.random.default_rng(11)\nx_e = rng_e.uniform(-3, 3, 200)\ny_e = np.sin(2.0 * x_e) + rng_e.normal(0, 0.25, 200)\nindex_e = rng_e.permutation(len(x_e))\nx_tr, x_te = x_e[index_e[:160]], x_e[index_e[160:]]\ny_tr, y_te = y_e[index_e[:160]], y_e[index_e[160:]]\n\nlearning_rate_e = 0.2\nprediction_tr = np.zeros_like(y_tr)\nprediction_te = np.zeros_like(y_te)\ntrain_errors, test_errors = [], []\nfor _ in range(60):\n    threshold, left_value, right_value = fit_stump(\n        x_tr,\n        y_tr - prediction_tr,\n    )\n    prediction_tr += learning_rate_e * stump_predict(\n        x_tr,\n        threshold,\n        left_value,\n        right_value,\n    )\n    prediction_te += learning_rate_e * stump_predict(\n        x_te,\n        threshold,\n        left_value,\n        right_value,\n    )\n    train_errors.append(np.mean((y_tr - prediction_tr) ** 2))\n    test_errors.append(np.mean((y_te - prediction_te) ** 2))\n\nfig, ax = plt.subplots(figsize=(7.0, 4.5))\nax.plot(\n    range(1, 61),\n    train_errors,\n    color=\"#4C78A8\",\n    linewidth=2.0,\n    label=\"Train MSE\",\n)\nax.plot(\n    range(1, 61),\n    test_errors,\n    color=\"#E45756\",\n    linewidth=2.0,\n    label=\"Test MSE\",\n)\nax.set(\n    xlabel=\"Number of trees (M)\",\n    ylabel=\"MSE\",\n    title=\"GBDT: Ensemble Size vs. Error\",\n)\nax.legend(frameon=False)\nax.grid(alpha=0.2)\nplt.show()"
  },
