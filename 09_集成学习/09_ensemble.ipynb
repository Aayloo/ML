   "source": "best_name = max(\n    diabetes_metrics,\n    key=lambda name: diabetes_metrics[name][\"R2\"],\n)\nbest_model = regressors[best_name]\nbest_pred = best_model.predict(diabetes_X_test)\n\nfig, axes = plt.subplots(\n    1,\n    2,\n    figsize=(11.2, 4.4),\n)\n\naxes[0].scatter(\n    diabetes_y_test,\n    best_pred,\n    s=24,\n    color=\"#4C78A8\",\n    edgecolor=\"white\",\n    linewidth=0.5,\n    zorder=3,\n)\nlims = [\n    min(diabetes_y_test.min(), best_pred.min()),\n    max(diabetes_y_test.max(), best_pred.max()),\n]\naxes[0].plot(\n    lims,\n    lims,\n    \"--\",\n    color=\"gray\",\n    linewidth=1.4,\n    label=\"y = x\",\n)\naxes[0].set(\n    xlabel=\"True progression\",\n    ylabel=\"Predicted progression\",\n    title=(\n        f\"{best_name}: Prediction vs. True \"\n        f\"(R²={diabetes_metrics[best_name]['R2']:.3f})\"\n    ),\n    xlim=lims,\n    ylim=lims,\n)\naxes[0].legend(frameon=False)\n\naxes[1].hist(\n    diabetes_y_test - best_pred,\n    bins=18,\n    color=\"#4C78A8\",\n    edgecolor=\"white\",\n)\naxes[1].axvline(\n    0,\n    color=\"#E45756\",\n    linewidth=1.6,\n    linestyle=\"--\",\n)\naxes[1].set(\n    xlabel=\"Residual\",\n    ylabel=\"Count\",\n    title=\"Residual Distribution\",\n)\n\nfor ax in axes:\n    ax.grid(alpha=0.2)\nfig.tight_layout()\nplt.show()"
