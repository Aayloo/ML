   "source": "# 复现图 2：GBDT 逐步拟合残差\ndef stump_predict(x, threshold, left_value, right_value):\n    return np.where(\n        x <= threshold,\n        left_value,\n        right_value,\n    )\n\n\ndef fit_stump(x, y):\n    best = None\n    for threshold in np.unique(x)[:-1]:\n        mask = x <= threshold\n        if mask.all() or (~mask).all():\n            continue\n        left_value = y[mask].mean()\n        right_value = y[~mask].mean()\n        squared_error = (\n            ((y[mask] - left_value) ** 2).sum()\n            + ((y[~mask] - right_value) ** 2).sum()\n        )\n        if best is None or squared_error < best[0]:\n            best = (\n                squared_error,\n                threshold,\n                left_value,\n                right_value,\n            )\n    return best[1:]\n\n\nrng_gb = np.random.default_rng(7)\nx_gb = np.sort(rng_gb.uniform(-3, 3, 120))\ny_gb = np.sin(2.0 * x_gb) + rng_gb.normal(0, 0.25, 120)\n\nfig, axes = plt.subplots(1, 3, figsize=(13.5, 4.0))\nresidual = y_gb.copy()\nlearning_rate_gb = 0.3\nfor panel in range(3):\n    threshold, left_value, right_value = fit_stump(x_gb, residual)\n    axes[panel].scatter(\n        x_gb,\n        residual,\n        s=12,\n        color=\"#4C78A8\",\n        zorder=3,\n    )\n    axes[panel].plot(\n        x_gb,\n        stump_predict(x_gb, threshold, left_value, right_value),\n        color=\"#E45756\",\n        linewidth=2.2,\n    )\n    axes[panel].axvline(\n        threshold,\n        color=\"#888888\",\n        linestyle=\"--\",\n        linewidth=1,\n    )\n    axes[panel].set(\n        title=f\"Step {panel + 1}: fit residual\",\n        xlabel=\"Feature x\",\n    )\n    axes[panel].grid(alpha=0.2)\n    residual = residual - learning_rate_gb * stump_predict(\n        x_gb,\n        threshold,\n        left_value,\n        right_value,\n    )\nfig.tight_layout()\nplt.show()"
  },
