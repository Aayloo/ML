   "source": "import json\n\nall_metrics = [\n    manual_mse,\n    manual_rmse,\n    manual_mae,\n    manual_r2,\n    *tree_metrics.values(),\n    *forest_metrics.values(),\n    *gbdt_credit_metrics.values(),\n    *xgb_credit_metrics.values(),\n    *diabetes_metrics[\"RandomForest\"].values(),\n    *diabetes_metrics[\"GBDT\"].values(),\n    *diabetes_metrics[\"XGBoost\"].values(),\n]\nassert np.all(np.isfinite(all_metrics))\nassert manual_r2 > 0.7\nassert forest_metrics[\"Accuracy\"] > 0.95\nassert forest_metrics[\"Accuracy\"] >= tree_metrics[\"Accuracy\"]\nassert gbdt_credit_metrics[\"ROC-AUC\"] > 0.72\nassert xgb_credit_metrics[\"ROC-AUC\"] > 0.72\nassert diabetes_metrics[\"XGBoost\"][\"R2\"] > 0.2\n\nvalidation = {\n    \"manual_r2\": float(manual_r2),\n    \"manual_loss_start\": float(\n        manual_model.train_loss_history_[0]\n    ),\n    \"manual_loss_end\": float(\n        manual_model.train_loss_history_[-1]\n    ),\n    \"tree_accuracy\": float(tree_metrics[\"Accuracy\"]),\n    \"forest_accuracy\": float(forest_metrics[\"Accuracy\"]),\n    \"credit_gbdt_roc_auc\": float(\n        gbdt_credit_metrics[\"ROC-AUC\"]\n    ),\n    \"credit_xgb_roc_auc\": float(\n        xgb_credit_metrics[\"ROC-AUC\"]\n    ),\n    \"diabetes_xgb_r2\": float(\n        diabetes_metrics[\"XGBoost\"][\"R2\"]\n    ),\n    \"image_count\": 11,\n}\nassert validation[\"manual_loss_end\"] < validation[\"manual_loss_start\"]\n\ndisplay_result_table(\n    \"Notebook 验证汇总（Notebook validation summary）\",\n    [\"检查项\", \"观测值\", \"状态\"],\n    [\n        [\"手写 GBDT Loss\", f'{validation[\"manual_loss_start\"]:.3f} → {validation[\"manual_loss_end\"]:.3f}', \"通过\"],\n        [\"手写 GBDT R²\", f'{validation[\"manual_r2\"]:.3f}', \"通过\"],\n        [\"随机森林 Accuracy\", f'{validation[\"forest_accuracy\"]:.3f}', \"通过\"],\n        [\"信用卡 GBDT ROC-AUC\", f'{validation[\"credit_gbdt_roc_auc\"]:.3f}', \"通过\"],\n        [\"信用卡 XGBoost ROC-AUC\", f'{validation[\"credit_xgb_roc_auc\"]:.3f}', \"通过\"],\n     