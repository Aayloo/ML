   ],
   "source": "n_values = [1, 5, 10, 20, 50, 100, 200]\nrf_accuracy = []\nfor n in n_values:\n    model = RandomForestClassifier(\n        n_estimators=n,\n        random_state=42,\n    )\n    model.fit(cancer_X_train, cancer_y_train)\n    rf_accuracy.append(\n        accuracy_score(\n            cancer_y_test,\n            model.predict(cancer_X_test),\n        )\n    )\n\nlearning_rate_values = [0.01, 0.05, 0.1, 0.3]\ngbdt_accuracy = []\nfor learning_rate in learning_rate_values:\n    model = GradientBoostingClassifier(\n        n_estimators=100,\n        learning_rate=learning_rate,\n        random_state=42,\n    )\n    model.fit(cancer_X_train, cancer_y_train)\n    gbdt_accuracy.append(\n        accuracy_score(\n            cancer_y_test,\n            model.predict(cancer_X_test),\n        )\n    )\n\nfig, axes = plt.subplots(\n    1,\n    2,\n    figsize=(11.2, 4.3),\n)\n\naxes[0].plot(\n    n_values,\n    rf_accuracy,\n    marker=\"o\",\n    color=\"#4C78A8\",\n    linewidth=2.0,\n)\naxes[0].set(\n    xlabel=\"n_estimators\",\n    ylabel=\"Test accuracy\",\n    title=\"Random Forest: Tree Count\",\n)\naxes[0].set_xscale(\"log\")\n\naxes[1].plot(\n    learning_rate_values,\n    gbdt_accuracy,\n    marker=\"o\",\n    color=\"#E45756\",\n    linewidth=2.0,\n)\naxes[1].set(\n    xlabel=\"learning_rate\",\n    ylabel=\"Test accuracy\",\n    title=\"GBDT: Learning Rate (100 trees)\",\n)\naxes[1].set_xscale(\"log\")\n\nfor ax in axes:\n    ax.grid(alpha=0.2)\nfig.tight_layout()\nplt.show()"
  },
