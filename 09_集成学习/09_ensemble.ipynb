   ],
   "source": "manual_model = GBDTRegressorScratch(\n    n_estimators=150,\n    learning_rate=0.1,\n).fit(manual_X_train, manual_y_train)\nmanual_pred = manual_model.predict(manual_X_test)\n\nmanual_mse = np.mean(\n    (manual_y_test - manual_pred) ** 2\n)\nmanual_rmse = np.sqrt(manual_mse)\nmanual_mae = np.mean(\n    np.abs(manual_y_test - manual_pred)\n)\nmanual_ss_res = np.sum(\n    (manual_y_test - manual_pred) ** 2\n)\nmanual_ss_tot = np.sum(\n    (manual_y_test - manual_y_test.mean()) ** 2\n)\nmanual_r2 = 1 - manual_ss_res / manual_ss_tot\n\nprint(\n    \"手写 GBDT: 树桩数量 =\",\n    manual_model.n_estimators,\n    \", 学习率 =\",\n    manual_model.learning_rate,\n)\nprint(\n    \"测试集: MSE =\",\n    round(manual_mse, 3),\n    \", RMSE =\",\n    round(manual_rmse, 3),\n    \", MAE =\",\n    round(manual_mae, 3),\n    \", R² =\",\n    round(manual_r2, 3),\n)\n\ndisplay_result_table(\n    \"手写 GBDT：测试集回归指标（test metrics）\",\n    [\"指标\", \"数值\"],\n    [\n        [\"MSE\", f\"{manual_mse:.3f}\"],\n        [\"RMSE\", f\"{manual_rmse:.3f}\"],\n        [\"MAE\", f\"{manual_mae:.3f}\"],\n        [\"R²\", f\"{manual_r2:.3f}\"],\n    ],\n)"
